# Copy to .env and adjust. All variables are prefixed SCENEMAKER_.
SCENEMAKER_ENVIRONMENT=dev
SCENEMAKER_API_BASE_URL=http://localhost:8000
SCENEMAKER_JWT_SECRET=replace-with-a-long-random-string

# Database: sqlite for quick local runs, postgres in docker compose / production
SCENEMAKER_DATABASE_URL=sqlite:///./scenemaker.db

# Queue: memory (single process) or redis
SCENEMAKER_QUEUE_BACKEND=memory
SCENEMAKER_REDIS_URL=redis://localhost:6379/0

# Storage: local or s3 (works with AWS S3, Cloudflare R2, MinIO)
SCENEMAKER_STORAGE_BACKEND=local
SCENEMAKER_STORAGE_LOCAL_DIR=./data
SCENEMAKER_S3_BUCKET=
SCENEMAKER_S3_REGION=us-east-1
SCENEMAKER_S3_ENDPOINT_URL=

# AI: fake (no GPU needed) or huggingface
SCENEMAKER_AI_BACKEND=fake
SCENEMAKER_HF_API_TOKEN=
SCENEMAKER_HF_FACE_SWAP_ENDPOINT=
SCENEMAKER_HF_AVATAR_ENDPOINT=
